# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=production
PORT=4000

# MongoDB Atlas (see lib/db.js)
DB_NAME=
DB_PASWORD=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Long random string. REQUIRED in production; tokens are signed with it.
JWT_SECRET=

# ── Dashboard options (all optional) ─────────────────────────────
# Days a listing stays live before it expires and must be renewed (default 30)
LISTING_DAYS=30
# true = new/edited listings wait in "Pending validation" until an admin approves them (default false)
MODERATE_LISTINGS=false
# Max live (active + pending) listings per user (default 100)
MAX_ACTIVE_LISTINGS=100

# ── Payments & escrow (Paystack) ─────────────────────────────────
# Secret key from Paystack dashboard → Settings → API Keys (sk_test_… to try it, sk_live_… to go live). NEVER put it in the React app.
PAYSTACK_SECRET_KEY=
# Public address of your site (used for the payment return link), e.g. https://generalmarket.ng
APP_URL=
# Try the whole escrow flow with a fake checkout and NO real money (ignored when NODE_ENV=production or a key is set)
PAYMENTS_DEMO=false

# How YOU earn (₦ amounts, percentages as plain numbers). Defaults shown.
SELLER_COMMISSION_PERCENT=5     # taken from the seller's payout
SELLER_COMMISSION_MIN=200
SELLER_COMMISSION_MAX=100000
BUYER_FEE_PERCENT=2             # service fee added to the buyer's total (covers Paystack's charge fee)
BUYER_FEE_FLAT=100
BUYER_FEE_MAX=3000
MIN_ORDER_NGN=1000
MAX_ORDER_NGN=20000000

# Escrow timing
ESCROW_PAY_WINDOW_MIN=30            # minutes the buyer has to pay
ESCROW_SELLER_DELIVER_DAYS=7        # seller must mark delivered by then, or the buyer is refunded automatically
ESCROW_CONFIRM_DAYS=3               # after "delivered", buyer has this long to confirm/dispute, then it auto-releases
ESCROW_REQUIRE_VERIFIED_SELLER=false
